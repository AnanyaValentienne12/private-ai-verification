import CompactStandardLibrary;

witness fetchPrivateAge(): Uint<32>;
witness fetchPrivateIncome(): Uint<32>;

export circuit verifyEligibility(
  userId: Bytes<32>,
  minAge: Uint<32>, 
  minIncome: Uint<32>
): [] {
  // Get the variables through witness
  const age = fetchPrivateAge();
  const income = fetchPrivateIncome();

  // ZK Constraints. If these fail, execution aborts locally.
  assert(age >= minAge, "Not Qualified due to Age");
  assert(income >= minIncome, "Not Qualified due to Income");
}